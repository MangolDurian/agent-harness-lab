# Copy this file to `.env` and fill in your values.
# cp .env.example .env

# 必填：API Key
#   - 智谱 AI GLM Coding Plan: 在智谱开放平台获取
API_KEY=your-api-key-here

# 必填：使用的模型 ID（示例）
#   - glm-5.1          ← GLM 5.1（推荐）
#   - glm-4.7          ← GLM 4.7
MODEL_ID=glm-5.1

# 必填：API 基础地址
#   - 智谱 AI（GLM 系列）：https://open.bigmodel.cn/api/paas/v4
BASE_URL=https://open.bigmodel.cn/api/paas/v4
